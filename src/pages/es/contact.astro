---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_ES } from '../../config/site';
---

<BaseLayout
  title="Contacto"
  description="Ponte en contacto con Mighty Little Bookshelf — preguntas, sugerencias de libros o correcciones."
  site={SITE_ES}
>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <p class="section-label">Contacto</p>
    <h1 class="mt-2 font-display text-3xl font-semibold sm:text-4xl">Nos encantaría saber de ti</h1>
    <p class="mt-3 max-w-xl text-ink-light">
      ¿Tienes una pregunta, una sugerencia de libro o una corrección a un listado? Envíanos un mensaje y te
      responderemos.
    </p>

    <form id="contact-form" class="card mt-8 space-y-4 p-6 sm:p-8" novalidate>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="name" class="block text-sm font-semibold text-ink">Nombre</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="mt-1 w-full rounded-xl border border-teal-200 bg-white px-4 py-2.5 text-ink focus:border-teal-500"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-semibold text-ink">Correo Electrónico</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="mt-1 w-full rounded-xl border border-teal-200 bg-white px-4 py-2.5 text-ink focus:border-teal-500"
          />
        </div>
      </div>
      <div>
        <label for="topic" class="block text-sm font-semibold text-ink">¿De qué se trata?</label>
        <select
          id="topic"
          name="topic"
          class="mt-1 w-full rounded-xl border border-teal-200 bg-white px-4 py-2.5 text-ink focus:border-teal-500"
        >
          <option>Pregunta general</option>
          <option>Sugerir un libro</option>
          <option>Corrección a un listado</option>
          <option>Colaboración / prensa</option>
          <option>Otra cosa</option>
        </select>
      </div>
      <div>
        <label for="message" class="block text-sm font-semibold text-ink">Mensaje</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="mt-1 w-full rounded-xl border border-teal-200 bg-white px-4 py-2.5 text-ink focus:border-teal-500"
        ></textarea>
      </div>
      <button type="submit" class="btn-primary">Enviar Mensaje</button>
      <p class="text-xs text-ink-light">
        Esto abrirá tu aplicación de correo con tu mensaje prellenado y dirigido a {SITE_ES.email}.
      </p>
    </form>
  </section>
</BaseLayout>

<script define:vars={{ email: SITE_ES.email }}>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = data.get('name') ?? '';
    const topic = data.get('topic') ?? 'Pregunta general';
    const message = data.get('message') ?? '';
    const senderEmail = data.get('email') ?? '';

    const subject = `[Mighty Little Bookshelf] ${topic}`;
    const body = `${message}\n\n— ${name} (${senderEmail})`;
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
