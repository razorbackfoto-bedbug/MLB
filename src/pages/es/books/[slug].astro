---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BookCover from '../../../components/BookCover.astro';
import BookCard from '../../../components/BookCard.astro';
import Badge from '../../../components/Badge.astro';
import { SITE_ES } from '../../../config/site';
import { getAllBooks, getSpanishBooks, localizeBook, formatAgeRange } from '../../../lib/books';
import { coverCandidatesFor } from '../../../lib/cover';
import { getPurchaseLink } from '../../../config/affiliate';
import { translateLabel, translateAudience } from '../../../i18n/labels';

export function getStaticPaths() {
  return getSpanishBooks().map((book) => ({
    params: { slug: book.slug },
  }));
}

const { slug } = Astro.params;
const rawBook = getSpanishBooks().find((b) => b.slug === slug);

if (!rawBook) {
  return Astro.redirect('/es/library/');
}

const book = localizeBook(rawBook, 'es');
const amazon = getPurchaseLink(book, 'es');
const pagePath = `/es/books/${book.slug}/`;
const pageUrl = new URL(pagePath, SITE_ES.url).toString();
const coverImage = coverCandidatesFor(book)[0] ?? undefined;
const hasEnglishCounterpart = getAllBooks().some((candidate) => candidate.slug === rawBook.slug);
const seoDescription = book.mlbSummary ?? `${book.title}, un libro infantil sobre ${book.medicalTopics.map((t) => translateLabel(t, 'es')).join(', ')}.`;

const bookSchema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  '@id': `${pageUrl}#book`,
  name: book.title,
  url: pageUrl,
  description: seoDescription,
  inLanguage: 'es-US',
  author: book.author ? { '@type': 'Person', name: book.author } : undefined,
  illustrator: book.illustrator ? { '@type': 'Person', name: book.illustrator } : undefined,
  isbn: book.isbn || undefined,
  datePublished: book.publicationYear ? String(book.publicationYear) : undefined,
  image: coverImage,
  about: book.medicalTopics.map((topic) => ({ '@type': 'Thing', name: translateLabel(topic, 'es') })),
  audience: { '@type': 'PeopleAudience', audienceType: translateAudience(book.audience, 'es') },
  sameAs: book.amazonProductUrl || undefined,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE_ES.url}/es/` },
    { '@type': 'ListItem', position: 2, name: 'Biblioteca de Libros', item: `${SITE_ES.url}/es/library/` },
    { '@type': 'ListItem', position: 3, name: book.title, item: pageUrl },
  ],
};

const related = getSpanishBooks()
  .filter((b) => b.slug !== book.slug && b.medicalTopics.some((t) => book.medicalTopics.includes(t)))
  .map((b) => localizeBook(b, 'es'))
  .slice(0, 4);

const infoRows: { label: string; value: string }[] = [
  { label: 'Ideal Para', value: translateAudience(book.audience, 'es') },
  { label: 'Temas', value: book.medicalTopics.map((t) => translateLabel(t, 'es')).join(', ') },
  { label: 'Formato', value: translateLabel(book.format, 'es') },
];
if (book.isbn) infoRows.push({ label: 'ISBN', value: book.isbn });
if (book.publicationYear) infoRows.push({ label: 'Publicado', value: String(book.publicationYear) });
---

<BaseLayout
  title={book.title}
  description={seoDescription}
  image={coverImage}
  imageAlt={`Portada de ${book.title}`}
  site={SITE_ES}
  ogType="book"
  alternateEnglishPath={hasEnglishCounterpart ? `/books/${book.slug}/` : null}
  alternateSpanishPath={pagePath}
  jsonLd={[bookSchema, breadcrumbSchema]}
>
  <section class="mx-auto max-w-6xl px-4 pb-4 pt-8 sm:px-6 lg:px-8">
    <nav class="text-sm text-ink-light" aria-label="Breadcrumb">
      <a href="/es/" class="hover:text-teal-700">Inicio</a> /
      <a href="/es/library/" class="hover:text-teal-700">Biblioteca de Libros</a> /
      <span class="text-ink">{book.title}</span>
    </nav>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[320px,1fr]">
      <div class="mx-auto w-full max-w-xs lg:mx-0">
        <BookCover book={book} lang="es" />
      </div>

      <div>
        <h1 class="font-display text-3xl font-semibold sm:text-4xl">{book.title}</h1>
        <p class="mt-2 text-ink-light">
          {book.author && <span>Por {book.author}</span>}
          {book.author && book.illustrator && <span> &nbsp;|&nbsp; </span>}
          {book.illustrator && <span>Ilustrado por {book.illustrator}</span>}
          {!book.author && !book.illustrator && <span>Autor e ilustrador aún no verificados</span>}
        </p>

        <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-ink-light">
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-4 w-4 text-teal-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="4" width="18" height="18" rx="3"></rect>
              <path d="M3 9h18M8 3v4M16 3v4" stroke-linecap="round"></path>
            </svg>
            {formatAgeRange(book, 'es')}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-4 w-4 text-coral-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="9" cy="8" r="3.2"></circle>
              <path d="M2.5 20c0-3.3 2.9-6 6.5-6s6.5 2.7 6.5 6" stroke-linecap="round"></path>
              <circle cx="17" cy="9.5" r="2.4"></circle>
              <path d="M14.8 20c.3-2.4 1.7-4.2 3.5-4.8" stroke-linecap="round"></path>
            </svg>
            {translateAudience(book.audience, 'es')}
          </span>
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
          {book.medicalTopics.map((topic) => <Badge label={translateLabel(topic, 'es')} />)}
          {book.siblingFocus && <Badge label="Enfoque en Hermanos" />}
        </div>

        <p class="mt-6 max-w-2xl leading-relaxed text-ink">
          {book.mlbSummary ?? 'Nuestro equipo está escribiendo una descripción original para este título. Vuelve pronto para ver el resumen completo de Mighty Little Bookshelf.'}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href={amazon.url}
            target="_blank"
            rel={amazon.isAffiliate ? 'noopener sponsored' : 'noopener'}
            class="btn-primary"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M4 4h16v16H4z" opacity="0"></path>
              <path d="M6 16c4 3 8 3 12 0" stroke-linecap="round"></path>
              <path d="M15 15.5c1.5 0 2.7-.4 2.7-.4s-.2 1.7-1.5 2.2" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M8 12V8a4 4 0 0 1 8 0v4" stroke-linecap="round"></path>
              <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"></circle>
            </svg>
            {amazon.label}
          </a>
        </div>
        {
          amazon.isAmazon && (
            <p class="mt-3 text-xs text-ink-light">Como Afiliados de Amazon, ganamos con las compras que califican.</p>
          )
        }
      </div>
    </div>

    <div class="mt-10 card p-6 sm:p-8">
      <h2 class="font-display text-lg font-semibold text-teal-700">Detalles del Libro</h2>
      <dl class="mt-4 grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
        {
          infoRows.map((row) => (
            <div class="flex flex-col border-b border-teal-50 pb-2 sm:flex-row sm:justify-between">
              <dt class="text-sm font-semibold text-ink-light">{row.label}</dt>
              <dd class="text-sm text-ink sm:text-right">{row.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="border-t border-teal-100 bg-white/60 py-14">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <h2 class="mb-6 text-2xl font-semibold">También te puede gustar</h2>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {related.map((b) => (
              <BookCard book={b} lang="es" />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
