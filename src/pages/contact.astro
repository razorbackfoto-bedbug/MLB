---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---

<BaseLayout title="Contact" description="Get in touch with Mighty Little Bookshelf — questions, book suggestions, or corrections.">
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <p class="section-label">Contact</p>
    <h1 class="mt-2 font-display text-3xl font-semibold sm:text-4xl">We'd love to hear from you</h1>
    <p class="mt-3 max-w-xl text-ink-light">
      Have a question, a book suggestion, or a correction to a listing? Send us a note and we'll get back to you.
    </p>

    <form
      id="contact-form"
      action="https://formsubmit.co/hello@mightylittlebookshelf.com"
      method="POST"
      class="card mt-8 space-y-4 p-6 sm:p-8"
    >
      <input type="hidden" name="_subject" value="New Mighty Little Bookshelf contact form message" />
      <input type="hidden" name="_cc" value="razorbackfoto@gmail.com" />
      <input type="hidden" name="_next" value="https://mightylittlebookshelf.com/contact/thanks/" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_url" value="https://mightylittlebookshelf.com/contact/" />
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="name" class="block text-sm font-semibold text-ink">Name</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="mt-1 w-full rounded-xl border border-teal-200 bg-white px-4 py-2.5 text-ink focus:border-teal-500"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-semibold text-ink">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-1 w-full rounded-xl border border-teal-200 bg-white px-4 py-2.5 text-ink focus:border-teal-500"
          />
        </div>
      </div>
      <div>
        <label for="topic" class="block text-sm font-semibold text-ink">What's this about?</label>
        <select
          id="topic"
          name="topic"
          class="mt-1 w-full rounded-xl border border-teal-200 bg-white px-4 py-2.5 text-ink focus:border-teal-500"
        >
          <option>General question</option>
          <option>Suggest a book</option>
          <option>Correction to a listing</option>
          <option>Partnership / press</option>
          <option>Something else</option>
        </select>
      </div>
      <div>
        <label for="message" class="block text-sm font-semibold text-ink">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="mt-1 w-full rounded-xl border border-teal-200 bg-white px-4 py-2.5 text-ink focus:border-teal-500"
        ></textarea>
      </div>
      <button type="submit" class="btn-primary">Send Message</button>
      <p class="text-xs text-ink-light">
        Your message is sent through the website to {SITE.email}. A delivery copy is also sent to our monitored inbox.
      </p>
    </form>
  </section>
</BaseLayout>
