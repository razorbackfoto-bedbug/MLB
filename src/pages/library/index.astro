---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookshelfIllustration from '../../components/BookshelfIllustration.astro';
import LibraryExplorer from '../../components/LibraryExplorer';
import {
  getAllBooks,
  getAllTopics,
  bookMatchesTopic,
  AGE_BUCKETS,
  getUniqueAudienceTags,
  getUniqueBookTypes,
} from '../../lib/books';

const topics = getAllTopics();
const books = getAllBooks().map((book) => ({
  ...book,
  topicSlugs: topics.filter((topic) => bookMatchesTopic(book, topic)).map((topic) => topic.slug),
}));

const audienceOptions = getUniqueAudienceTags();
const bookTypeOptions = getUniqueBookTypes();
const bookCount = books.length;
---

<BaseLayout
  title="Children's Medical Book Library"
  description={`Search ${bookCount} curated children's books about NICU stays, hospitals, surgery, heart conditions, respiratory care, feeding tubes, cancer, grief, siblings, and other medical experiences.`}
>
  <section class="mx-auto max-w-7xl px-4 pb-6 pt-10 sm:px-6 lg:px-8">
    <div class="grid items-center gap-8 lg:grid-cols-[1.2fr,0.8fr]">
      <div>
        <h1 class="font-display text-3xl font-semibold sm:text-4xl">
          Children&apos;s books about medical experiences
          <span aria-hidden="true" class="text-coral-400"> ♥</span>
        </h1>
        <p class="mt-3 max-w-2xl text-ink-light">
          Search and filter children&apos;s books about NICU stays, premature birth, hospitals, surgery, heart conditions, respiratory support, feeding tubes, cancer, grief, sibling experiences, and other medical journeys.
        </p>
      </div>
      <div class="hidden lg:block">
        <BookshelfIllustration class="h-40 w-full" />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-teal-100 bg-white/70 p-5 shadow-sm sm:p-6">
      <p class="font-display text-xl font-semibold text-teal-700 sm:text-2xl">
        {bookCount} thoughtfully curated books for children and families navigating medical experiences.
      </p>
      <p class="mt-3 max-w-4xl text-sm leading-6 text-ink-light sm:text-base">
        Every child&apos;s journey is different, and no single book will be right for every family or every moment. Use the filters below to narrow the library by medical topic, age, audience, and book type, then review each guide for details that can help you choose a useful fit.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
    <div class="library-explorer-shell">
      <LibraryExplorer
        client:load
        books={books}
        topics={topics}
        ageBuckets={AGE_BUCKETS}
        audienceOptions={audienceOptions}
        bookTypeOptions={bookTypeOptions}
      />
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-16 text-center sm:px-6 lg:px-8">
    <p class="font-display text-xl font-semibold text-teal-700">A book-finding resource for families and healthcare teams</p>
    <p class="mx-auto mt-3 max-w-3xl text-sm leading-6 text-ink-light sm:text-base">
      Parents, caregivers, child life specialists, nurses, social workers, and librarians can use Mighty Little Bookshelf to discover reading resources for difficult or unfamiliar medical experiences. Healthcare professionals can learn more on our <a href="/for-hospitals/" class="font-semibold text-teal-700 underline">hospital and clinician resource page</a>.
    </p>
  </section>
</BaseLayout>

<style is:global>
  @media (min-width: 1024px) {
    .library-explorer-shell aside.card {
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
    }
  }
</style>
