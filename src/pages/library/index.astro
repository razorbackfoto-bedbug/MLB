---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookshelfIllustration from '../../components/BookshelfIllustration.astro';
import LibraryExplorer from '../../components/LibraryExplorer';
import {
  getAllBooks,
  getAllTopics,
  bookMatchesTopic,
  AGE_BUCKETS,
  getUniqueAudienceTags,
  getUniqueBookTypes,
} from '../../lib/books';

const topics = getAllTopics();
const books = getAllBooks().map((book) => ({
  ...book,
  topicSlugs: topics.filter((topic) => bookMatchesTopic(book, topic)).map((topic) => topic.slug),
}));

const audienceOptions = getUniqueAudienceTags();
const bookTypeOptions = getUniqueBookTypes();
const bookCount = books.length;
---

<BaseLayout
  title="Book Library"
  description="Search and filter our full library of children's books for NICU, hospital, and medical-experience families."
>
  <section class="mx-auto max-w-7xl px-4 pb-6 pt-10 sm:px-6 lg:px-8">
    <div class="grid items-center gap-8 lg:grid-cols-[1.2fr,0.8fr]">
      <div>
        <h1 class="font-display text-3xl font-semibold sm:text-4xl">
          Find the right book for your <span class="text-coral-400">family</span>
          <span aria-hidden="true" class="text-coral-400">♥</span>
        </h1>
        <p class="mt-3 max-w-xl text-ink-light">
          Explore our thoughtfully gathered children's books to help families navigate NICU stays, hospital
          experiences, medical conditions, and more.
        </p>
      </div>
      <div class="hidden lg:block">
        <BookshelfIllustration class="h-40 w-full" />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-teal-100 bg-white/70 p-5 shadow-sm sm:p-6">
      <p class="font-display text-xl font-semibold text-teal-700 sm:text-2xl">
        {bookCount} thoughtfully curated books for children and families navigating medical experiences.
      </p>
      <p class="mt-3 max-w-4xl text-sm leading-6 text-ink-light sm:text-base">
        Every child's journey is different, and no single book will be right for every family or every moment. We encourage caregivers to explore these resources at their own pace and choose the stories that feel right for their child today.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
    <div class="library-explorer-shell">
      <LibraryExplorer
        client:load
        books={books}
        topics={topics}
        ageBuckets={AGE_BUCKETS}
        audienceOptions={audienceOptions}
        bookTypeOptions={bookTypeOptions}
      />
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-16 text-center sm:px-6 lg:px-8">
    <p class="font-display text-xl font-semibold text-teal-700">You are not alone, and neither is your child.</p>
    <p class="mx-auto mt-3 max-w-3xl text-sm leading-6 text-ink-light sm:text-base">
      We hope these books offer comfort, spark meaningful conversations, and remind families that strength, courage, and joy can exist alongside medical challenges.
    </p>
  </section>
</BaseLayout>

<style is:global>
  @media (min-width: 1024px) {
    .library-explorer-shell aside.card {
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
    }
  }
</style>
