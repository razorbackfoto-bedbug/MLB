---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import TopicIcon from '../../components/TopicIcon.astro';
import { getAllTopics, getBooksForTopic, getSpanishBooks, bookMatchesTopic, type Topic } from '../../lib/books';

export function getStaticPaths() {
  return getAllTopics().map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

interface Props {
  topic: Topic;
}

const { topic } = Astro.props as Props;
const books = getBooksForTopic(topic.slug);
const spanishBooks = getSpanishBooks();
const hasSpanishAlternate = spanishBooks.some((book) => bookMatchesTopic(book, topic));

const seoTitles: Record<string, string> = {
  'nicu-prematurity': "Children's Books About the NICU & Prematurity",
  siblings: "Children's Books for Siblings During Medical Care",
  'hospital-stays': "Children's Books About Hospital Stays & Surgery",
  cardiac: "Children's Books About Heart Conditions & Cardiac Care",
  respiratory: "Children's Books About Breathing, Oxygen & Respiratory Care",
  'feeding-tubes': "Children's Books About Feeding Tubes & G-Tubes",
  oncology: "Children's Books About Cancer & Oncology",
  'genetics-rare-disease': "Children's Books About Genetics & Rare Disease",
  'grief-loss': "Children's Books About Grief & Loss",
  'feelings-coping': "Children's Books About Medical Anxiety & Coping",
  'parent-resources': 'Books & Resources for Parents of Medically Complex Children',
};

const seoTitle = seoTitles[topic.slug] ?? `Children's Books About ${topic.label}`;
const seoDescription = `${topic.description} Browse ${books.length} curated ${books.length === 1 ? 'book' : 'books'} for children and families.`;
const pagePath = `/topics/${topic.slug}/`;
const pageUrl = new URL(pagePath, 'https://mightylittlebookshelf.com').toString();

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  name: seoTitle,
  url: pageUrl,
  description: seoDescription,
  inLanguage: 'en-US',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: books.length,
    itemListElement: books.map((book, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/books/${book.slug}/`, 'https://mightylittlebookshelf.com').toString(),
      name: book.title,
    })),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mightylittlebookshelf.com/' },
    { '@type': 'ListItem', position: 2, name: 'Topics', item: 'https://mightylittlebookshelf.com/topics/' },
    { '@type': 'ListItem', position: 3, name: topic.label, item: pageUrl },
  ],
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  alternateEnglishPath={pagePath}
  alternateSpanishPath={hasSpanishAlternate ? `/es/topics/${topic.slug}/` : null}
  jsonLd={[collectionSchema, breadcrumbSchema]}
>
  <section class="mx-auto max-w-5xl px-4 pb-4 pt-8 sm:px-6 lg:px-8">
    <nav class="text-sm text-ink-light" aria-label="Breadcrumb">
      <a href="/" class="hover:text-teal-700">Home</a> /
      <a href="/topics/" class="hover:text-teal-700">Topics</a> /
      <span class="text-ink">{topic.label}</span>
    </nav>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-10 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center">
      <span class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-2xl bg-teal-100 text-teal-700">
        <TopicIcon name={topic.icon} class="h-7 w-7" />
      </span>
      <div>
        <h1 class="font-display text-3xl font-semibold sm:text-4xl">{seoTitle}</h1>
        <p class="mt-2 max-w-2xl text-ink-light">{topic.description}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    {
      books.length === 0 ? (
        <div class="card p-10 text-center">
          <p class="font-display text-lg text-teal-700">We're still adding books for this topic.</p>
          <p class="mt-2 text-sm text-ink-light">
            Check back soon, or browse the{' '}
            <a href="/library/" class="font-semibold text-teal-700 underline">
              full library
            </a>{' '}
            in the meantime.
          </p>
        </div>
      ) : (
        <>
          <p class="mb-6 text-sm font-semibold text-ink-light">
            {books.length} {books.length === 1 ? 'book' : 'books'} for {topic.label}
          </p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {books.map((book) => (
              <BookCard book={book} />
            ))}
          </div>
        </>
      )
    }
  </section>
</BaseLayout>
