---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import TopicIcon from '../../components/TopicIcon.astro';
import { getAllTopics, getBooksForTopic, getSpanishBooks, bookMatchesTopic, type Topic } from '../../lib/books';

export function getStaticPaths() {
  return getAllTopics().map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

interface Props {
  topic: Topic;
}

const { topic } = Astro.props as Props;
const books = getBooksForTopic(topic.slug);
const spanishBooks = getSpanishBooks();
const hasSpanishAlternate = spanishBooks.some((book) => bookMatchesTopic(book, topic));
const isNicu = topic.slug === 'nicu-prematurity';
const isHospital = topic.slug === 'hospital-stays';

const seoTitles: Record<string, string> = {
  'nicu-prematurity': 'NICU Books for Kids, Siblings & Families',
  siblings: "Children's Books for Siblings During Medical Care",
  'hospital-stays': 'Hospital Books for Kids: Surgery, Procedures & Hospital Stays',
  cardiac: "Children's Books About Heart Conditions & Cardiac Care",
  respiratory: "Children's Books About Breathing, Oxygen & Respiratory Care",
  'feeding-tubes': "Children's Books About Feeding Tubes & G-Tubes",
  oncology: "Children's Books About Cancer & Oncology",
  'genetics-rare-disease': "Children's Books About Genetics & Rare Disease",
  'grief-loss': "Children's Books About Grief & Loss",
  'feelings-coping': "Children's Books About Medical Anxiety & Coping",
  'parent-resources': 'Books & Resources for Parents of Medically Complex Children',
};

const seoTitle = seoTitles[topic.slug] ?? `Children's Books About ${topic.label}`;
const seoDescription = isNicu
  ? `Browse ${books.length} curated NICU books for kids, siblings, and families, including children's books about premature babies, preemies, NICU stays, and coming home.`
  : isHospital
    ? `Browse ${books.length} hospital books for kids, including children's books about surgery, medical procedures, hospital stays, tests, and preparing a child for the hospital.`
    : `${topic.description} Browse ${books.length} curated ${books.length === 1 ? 'book' : 'books'} for children and families.`;
const pagePath = `/topics/${topic.slug}/`;
const pageUrl = new URL(pagePath, 'https://mightylittlebookshelf.com').toString();

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  name: seoTitle,
  url: pageUrl,
  description: seoDescription,
  inLanguage: 'en-US',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: books.length,
    itemListElement: books.map((book, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/books/${book.slug}/`, 'https://mightylittlebookshelf.com').toString(),
      name: book.title,
    })),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mightylittlebookshelf.com/' },
    { '@type': 'ListItem', position: 2, name: 'Topics', item: 'https://mightylittlebookshelf.com/topics/' },
    { '@type': 'ListItem', position: 3, name: topic.label, item: pageUrl },
  ],
};

const nicuFaq = [
  {
    question: 'What are NICU books for kids?',
    answer: 'NICU books for kids use child-friendly stories and illustrations to explain premature birth, neonatal intensive care, medical equipment, hospital routines, and the experience of having a baby in the NICU.',
  },
  {
    question: 'Are there NICU books for siblings?',
    answer: 'Yes. Many NICU books are written specifically for big brothers and sisters. They can help siblings understand why a new baby may need to stay in the hospital, what they may see or hear in the NICU, and how they can stay connected to their new sibling.',
  },
  {
    question: 'Are there children’s books about premature babies and preemies?',
    answer: 'Yes. Children’s books about premature babies often focus on being born early, growing stronger in the NICU, medical support a preemie may need, and the transition from the hospital to home.',
  },
  {
    question: 'How do I choose a NICU book for a child?',
    answer: 'Start with the child’s age, relationship to the baby, and what you want the book to explain. Younger children often benefit from simple picture books, while older siblings may appreciate stories with more detail about the NICU experience and medical care.',
  },
];

const hospitalFaq = [
  {
    question: 'What are good hospital books for kids?',
    answer: 'Good hospital books for kids explain what children may see, hear, and experience during a hospital visit in clear, reassuring language. The best choice depends on the child’s age and whether they are preparing for surgery, a test, a procedure, or a longer hospital stay.',
  },
  {
    question: 'Are there children’s books about surgery?',
    answer: 'Yes. Children’s books about surgery can introduce ideas such as meeting the care team, anesthesia, operating rooms, recovery, bandages, and going home. Familiarity can make an unfamiliar experience easier to talk about with a child.',
  },
  {
    question: 'Can books help prepare a child for a hospital stay?',
    answer: 'Books can help children build a mental picture of what a hospital visit may be like and give families a starting point for questions and conversations. They are especially useful when paired with information from the child’s own care team about what to expect.',
  },
  {
    question: 'How do I choose a hospital or surgery book for my child?',
    answer: 'Choose a book that matches the child’s age, reading level, and upcoming experience. A child having a routine procedure may need a different story than a child facing major surgery or a long admission, so look for books that reflect the situation as closely as possible.',
  },
];

const activeFaq = isNicu ? nicuFaq : isHospital ? hospitalFaq : null;

const faqSchema = activeFaq
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: activeFaq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;

const jsonLd = faqSchema ? [collectionSchema, breadcrumbSchema, faqSchema] : [collectionSchema, breadcrumbSchema];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  alternateEnglishPath={pagePath}
  alternateSpanishPath={hasSpanishAlternate ? `/es/topics/${topic.slug}/` : null}
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-5xl px-4 pb-4 pt-8 sm:px-6 lg:px-8">
    <nav class="text-sm text-ink-light" aria-label="Breadcrumb">
      <a href="/" class="hover:text-teal-700">Home</a> /
      <a href="/topics/" class="hover:text-teal-700">Topics</a> /
      <span class="text-ink">{topic.label}</span>
    </nav>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-10 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center">
      <span class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-2xl bg-teal-100 text-teal-700">
        <TopicIcon name={topic.icon} class="h-7 w-7" />
      </span>
      <div>
        <h1 class="font-display text-3xl font-semibold sm:text-4xl">{seoTitle}</h1>
        {isNicu ? (
          <p class="mt-2 max-w-3xl text-ink-light">
            Find children&apos;s books about NICU stays, premature birth, preemies, medical equipment, coming home from the NICU, and becoming a big brother or sister to a baby in neonatal intensive care.
          </p>
        ) : isHospital ? (
          <p class="mt-2 max-w-3xl text-ink-light">
            Find hospital books for kids about surgery, medical procedures, tests, anesthesia, recovery, hospital stays, and preparing children for what they may see and experience during medical care.
          </p>
        ) : (
          <p class="mt-2 max-w-2xl text-ink-light">{topic.description}</p>
        )}
      </div>
    </div>
  </section>

  {isNicu && (
    <section class="mx-auto max-w-5xl px-4 pb-12 sm:px-6 lg:px-8">
      <div class="card p-6 sm:p-8">
        <h2 class="font-display text-2xl font-semibold">Children&apos;s books for understanding the NICU</h2>
        <div class="mt-4 space-y-4 text-ink-light">
          <p>
            A NICU stay can be hard to explain to a child. The books in this collection can help families introduce ideas such as premature birth, incubators, monitors, breathing support, feeding support, hospital routines, and the wait to bring a baby home using language and pictures children can understand.
          </p>
          <p>
            If you are helping an older brother or sister understand what is happening, also browse our{' '}
            <a href="/topics/siblings/" class="font-semibold text-teal-700 underline decoration-teal-300 underline-offset-2 hover:text-teal-800">
              books for siblings during medical care
            </a>.
            For books about procedures, surgery, and hospital visits, see{' '}
            <a href="/topics/hospital-stays/" class="font-semibold text-teal-700 underline decoration-teal-300 underline-offset-2 hover:text-teal-800">
              hospital and surgery books for kids
            </a>.
          </p>
        </div>
      </div>
    </section>
  )}

  {isHospital && (
    <section class="mx-auto max-w-5xl px-4 pb-12 sm:px-6 lg:px-8">
      <div class="card p-6 sm:p-8">
        <h2 class="font-display text-2xl font-semibold">Children&apos;s books for hospital stays, surgery, and procedures</h2>
        <div class="mt-4 space-y-4 text-ink-light">
          <p>
            Hospitals can feel unfamiliar to children, especially when they are preparing for surgery, imaging, lab work, anesthesia, or an overnight admission. The books in this collection can help introduce hospital rooms, medical equipment, doctors and nurses, procedures, recovery, and going home in a way children can revisit at their own pace.
          </p>
          <p>
            For children dealing with fear or uncertainty, browse our{' '}
            <a href="/topics/feelings-coping/" class="font-semibold text-teal-700 underline decoration-teal-300 underline-offset-2 hover:text-teal-800">
              books about medical anxiety and coping
            </a>.
            If a brother or sister is the one receiving care, our{' '}
            <a href="/topics/siblings/" class="font-semibold text-teal-700 underline decoration-teal-300 underline-offset-2 hover:text-teal-800">
              books for siblings during medical care
            </a>{' '}
            may also help.
          </p>
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    {
      books.length === 0 ? (
        <div class="card p-10 text-center">
          <p class="font-display text-lg text-teal-700">We're still adding books for this topic.</p>
          <p class="mt-2 text-sm text-ink-light">
            Check back soon, or browse the{' '}
            <a href="/library/" class="font-semibold text-teal-700 underline">
              full library
            </a>{' '}
            in the meantime.
          </p>
        </div>
      ) : (
        <>
          <h2 class="mb-2 font-display text-2xl font-semibold">
            {isNicu ? 'Browse NICU and preemie books' : isHospital ? 'Browse hospital and surgery books for kids' : `Books for ${topic.label}`}
          </h2>
          <p class="mb-6 text-sm font-semibold text-ink-light">
            {books.length} {books.length === 1 ? 'book' : 'books'} for {topic.label}
          </p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {books.map((book) => (
              <BookCard book={book} />
            ))}
          </div>
        </>
      )
    }
  </section>

  {activeFaq && (
    <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6 lg:px-8">
      <div class="border-t border-sand-200 pt-10">
        <h2 class="font-display text-2xl font-semibold">
          {isNicu ? 'NICU books: common questions' : 'Hospital and surgery books: common questions'}
        </h2>
        <div class="mt-6 space-y-7">
          {activeFaq.map((item) => (
            <div>
              <h3 class="font-display text-lg font-semibold text-ink">{item.question}</h3>
              <p class="mt-2 text-ink-light">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
