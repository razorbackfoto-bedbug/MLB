---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookshelfIllustration from '../../components/BookshelfIllustration.astro';
import TopicCard from '../../components/TopicCard.astro';
import { getAllTopics } from '../../lib/books';

const topics = getAllTopics();
---

<BaseLayout
  title="Children's Medical Books by Topic"
  description="Browse children's medical books by topic, including NICU and prematurity, hospital stays, surgery, cardiac conditions, respiratory care, feeding tubes, cancer, grief, and sibling support."
>
  <section class="mx-auto max-w-7xl px-4 pb-8 pt-10 sm:px-6 lg:px-8">
    <div class="grid items-center gap-8 lg:grid-cols-[1.2fr,0.8fr]">
      <div>
        <h1 class="font-display text-3xl font-semibold sm:text-4xl">
          Children&apos;s medical books by topic <span aria-hidden="true" class="text-coral-400">♥</span>
        </h1>
        <p class="mt-3 max-w-2xl text-ink-light">
          Find children&apos;s books about the NICU, premature birth, hospital stays, surgery, heart conditions, respiratory support, feeding tubes, cancer, grief, sibling experiences, and other medical journeys. Browse by the experience you need to explain, then compare books by age, audience, and focus.
        </p>
      </div>
      <div class="hidden lg:block">
        <BookshelfIllustration class="h-40 w-full" />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {topics.map((topic) => <TopicCard topic={topic} />)}
    </div>
  </section>

  <section class="border-t border-teal-100 bg-white/60 py-10">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-4 text-center sm:flex-row sm:text-left sm:px-6 lg:px-8">
      <div>
        <h2 class="font-display text-xl font-semibold text-teal-700">Looking for something specific?</h2>
        <p class="mt-1 text-ink-light">Search the full library by title, age, audience, or medical theme. Healthcare teams can also visit our <a href="/for-hospitals/" class="font-semibold text-teal-700 underline">hospital and clinician resource page</a>.</p>
      </div>
      <a href="/library/" class="btn-primary">Open Book Library</a>
    </div>
  </section>
</BaseLayout>
