---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangPrompt from '../components/LangPrompt.astro';
import { SITE, type SiteConfig } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  site?: SiteConfig;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, noindex = false, site = SITE, jsonLd } = Astro.props;
const resolvedDescription = description ?? site.description;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonicalURL = new URL(Astro.url.pathname, site.url);
const ogImage = image ? new URL(image, site.url) : null;

const pathname = Astro.url.pathname;
const simpleAlternatePaths = new Set([
  '/',
  '/about/',
  '/contact/',
  '/library/',
  '/topics/',
  '/privacy-policy/',
  '/affiliate-disclosure/',
]);
const englishPath = pathname.startsWith('/es/') ? pathname.replace(/^\/es/, '') || '/' : pathname;
const spanishPath = pathname.startsWith('/es/') ? pathname : pathname === '/' ? '/es/' : `/es${pathname}`;
const hasSimpleAlternate = simpleAlternatePaths.has(englishPath);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  description: site.description,
  email: site.email,
  sameAs: [site.social.instagram, site.social.facebook, site.social.pinterest].filter(Boolean),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  description: site.description,
  inLanguage: site.lang === 'es' ? 'es-US' : 'en-US',
  publisher: { '@id': `${site.url}/#organization` },
};

const extraSchemas = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const schemas = [organizationSchema, websiteSchema, ...extraSchemas];
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {hasSimpleAlternate && <link rel="alternate" hreflang="en" href={new URL(englishPath, site.url)} />}
    {hasSimpleAlternate && <link rel="alternate" hreflang="es" href={new URL(spanishPath, site.url)} />}
    {hasSimpleAlternate && <link rel="alternate" hreflang="x-default" href={new URL(englishPath, site.url)} />}
    <title>{pageTitle}</title>
    <meta name="description" content={resolvedDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={site.lang === 'es' ? 'es_US' : 'en_US'} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-teal-700 focus:px-4 focus:py-2 focus:text-cream-50"
    >
      {site.lang === 'es' ? 'Saltar al contenido principal' : 'Skip to main content'}
    </a>
    <Header site={site} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer site={site} />
    {site.lang === 'en' && <LangPrompt />}
  </body>
</html>
