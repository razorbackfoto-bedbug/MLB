---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangPrompt from '../components/LangPrompt.astro';
import { SITE, type SiteConfig } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  /** Bypasses the "Title | Site name" template — use when a page needs exact control. */
  fullTitle?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  site?: SiteConfig;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article' | 'book';
  alternateEnglishPath?: string | null;
  alternateSpanishPath?: string | null;
}

const {
  title,
  fullTitle,
  description,
  image,
  imageAlt,
  noindex = false,
  site = SITE,
  jsonLd,
  ogType = 'website',
  alternateEnglishPath,
  alternateSpanishPath,
} = Astro.props;
const resolvedDescription = description ?? site.description;
const pageTitle = fullTitle ?? (title === site.name ? title : `${title} | ${site.name}`);
const canonicalURL = new URL(Astro.url.pathname, site.url);
// Every page gets a social preview: a book's own cover when we have one, otherwise
// the branded default card, so shared links never render as a bare text snippet.
const DEFAULT_OG_IMAGE = '/og-default.png';
const DEFAULT_OG_IMAGE_ALT = `${site.name} — ${site.tagline}`;
const usingDefaultOgImage = !image;
const ogImage = new URL(image ?? DEFAULT_OG_IMAGE, site.url);
const ogImageAlt = usingDefaultOgImage ? DEFAULT_OG_IMAGE_ALT : imageAlt;

const pathname = Astro.url.pathname;
const simpleAlternatePaths = new Set([
  '/',
  '/about/',
  '/contact/',
  '/library/',
  '/topics/',
  '/privacy-policy/',
  '/affiliate-disclosure/',
]);
const englishPath = pathname.startsWith('/es/') ? pathname.replace(/^\/es/, '') || '/' : pathname;
const spanishPath = pathname.startsWith('/es/') ? pathname : pathname === '/' ? '/es/' : `/es${pathname}`;
const hasSimpleAlternate = simpleAlternatePaths.has(englishPath);
const resolvedEnglishAlternate = alternateEnglishPath !== undefined
  ? alternateEnglishPath
  : hasSimpleAlternate
    ? englishPath
    : null;
const resolvedSpanishAlternate = alternateSpanishPath !== undefined
  ? alternateSpanishPath
  : hasSimpleAlternate
    ? spanishPath
    : null;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  description: site.description,
  email: site.email,
  sameAs: [site.social.instagram, site.social.facebook, site.social.pinterest].filter(Boolean),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  description: site.description,
  inLanguage: site.lang === 'es' ? 'es-US' : 'en-US',
  publisher: { '@id': `${site.url}/#organization` },
};

const extraSchemas = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const schemas = [organizationSchema, websiteSchema, ...extraSchemas];
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {resolvedEnglishAlternate && <link rel="alternate" hreflang="en-US" href={new URL(resolvedEnglishAlternate, site.url)} />}
    {resolvedSpanishAlternate && <link rel="alternate" hreflang="es-US" href={new URL(resolvedSpanishAlternate, site.url)} />}
    {resolvedEnglishAlternate && <link rel="alternate" hreflang="x-default" href={new URL(resolvedEnglishAlternate, site.url)} />}
    <title>{pageTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={site.lang === 'es' ? 'es_US' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImage} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-teal-700 focus:px-4 focus:py-2 focus:text-cream-50"
    >
      {site.lang === 'es' ? 'Saltar al contenido principal' : 'Skip to main content'}
    </a>
    <Header site={site} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer site={site} />
    {site.lang === 'en' && <LangPrompt />}
  </body>
</html>
