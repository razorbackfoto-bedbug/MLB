---
import { SITE, type SiteConfig } from '../config/site';
import { BUILD_INFO } from '../lib/buildInfo';
import Logo from './Logo.astro';
import Newsletter from './Newsletter.astro';

interface Props {
  site?: SiteConfig;
}
const { site = SITE } = Astro.props as Props;
const isSpanish = site.lang === 'es';

const builtAtLabel = new Intl.DateTimeFormat(isSpanish ? 'es-ES' : 'en-US', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'UTC',
}).format(BUILD_INFO.builtAt) + ' UTC';
---

<footer class="border-t border-teal-100 bg-cream-200/70">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href={site.homeHref} class="flex items-center gap-3">
          <Logo class="h-8 w-8" />
          <span class="font-display text-lg font-semibold text-teal-700">{site.name}</span>
        </a>
        <p class="mt-3 max-w-xs text-sm text-ink-light">
          {site.footerTagline}
        </p>
      </div>

      <div>
        <h2 class="font-body text-sm font-bold uppercase tracking-wide text-teal-700">{site.quickLinksHeading}</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {
            site.footerLinks.quickLinks.map((link) => (
              <li>
                <a href={link.href} class="text-ink-light hover:text-teal-700">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-body text-sm font-bold uppercase tracking-wide text-teal-700">{site.stayLoopHeading}</h2>
        <p class="mt-3 text-sm text-ink-light">{site.stayLoopText}</p>
        <div class="mt-3">
          <Newsletter lang={site.lang} />
        </div>
      </div>

      <div>
        <h2 class="font-body text-sm font-bold uppercase tracking-wide text-teal-700">{site.connectHeading}</h2>
        <div class="mt-3 flex gap-3">
          <a
            href={SITE.social.instagram}
            class="flex h-9 w-9 items-center justify-center rounded-full bg-teal-700 text-cream-50 hover:bg-teal-600"
            aria-label={isSpanish ? 'Mighty Little Bookshelf en Instagram' : 'Mighty Little Bookshelf on Instagram'}
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.2" cy="6.8" r="1"></circle>
            </svg>
          </a>
          <a
            href={SITE.social.facebook}
            class="flex h-9 w-9 items-center justify-center rounded-full bg-teal-700 text-cream-50 hover:bg-teal-600"
            aria-label={isSpanish ? 'Mighty Little Bookshelf en Facebook' : 'Mighty Little Bookshelf on Facebook'}
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M15 8h2V4h-2a4 4 0 0 0-4 4v2H9v4h2v6h4v-6h2.5l.5-4H15V8Z"></path>
            </svg>
          </a>
          <a
            href={SITE.social.pinterest}
            class="flex h-9 w-9 items-center justify-center rounded-full bg-teal-700 text-cream-50 hover:bg-teal-600"
            aria-label={isSpanish ? 'Mighty Little Bookshelf en Pinterest' : 'Mighty Little Bookshelf on Pinterest'}
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M9.5 18c1-3 1.3-4.6 1.3-4.6M12 12a2.5 2.5 0 1 0 2.5-3.6c-1.6-.5-3.3.3-3.8 2L9.7 14"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 border-t border-teal-100 pt-6 text-center">
      <p class="text-xs text-coral-600">
        {site.affiliateDisclosureShort}
      </p>
      <div class="mt-2 flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs text-ink-light">
        {
          site.footerLinks.legal.map((link, i) => (
            <>
              {i > 0 && <span aria-hidden="true">·</span>}
              <a href={link.href} class="hover:text-teal-700">
                {link.label}
              </a>
            </>
          ))
        }
        <span aria-hidden="true">·</span>
        <span>&copy; {new Date().getFullYear()} {site.name}</span>
      </div>
      <p class="mt-2 text-center text-[0.7rem] text-ink-light">
        {isSpanish ? 'Versión del sitio' : 'Site build'}{' '}
        {BUILD_INFO.commitUrl ? (
          <a href={BUILD_INFO.commitUrl} class="hover:text-teal-700" target="_blank" rel="noopener noreferrer">
            #{BUILD_INFO.shortSha}
          </a>
        ) : (
          <span>#{BUILD_INFO.shortSha}</span>
        )}
        {' · '}{builtAtLabel}
      </p>
    </div>
  </div>
</footer>
