---
import type { Book } from '../lib/books';
import { formatAgeRange } from '../lib/books';
import { translateLabel } from '../i18n/labels';
import { t, type Lang } from '../i18n/ui';
import BookCover from './BookCover.astro';
import Badge from './Badge.astro';

interface Props {
  book: Book;
  class?: string;
  lang?: Lang;
  compact?: boolean;
}
const { book, class: className = '', lang = 'en', compact = false } = Astro.props;
const ui = t(lang);
const booksHref = lang === 'es' ? '/es/books' : '/books';
const isComplete = Boolean(book.author && book.mlbSummary && book.audience && book.medicalTopics.length > 0);
const hasAge = book.ageMin != null || book.ageMax != null;
const topBadges = book.medicalTopics.slice(0, 2);
---

{
  isComplete && (
    <article class:list={['card flex h-full flex-col overflow-hidden', compact ? 'p-2.5' : 'p-3', className]}>
      <a href={`${booksHref}/${book.slug}/`} class="block">
        <BookCover book={book} lang={lang} fit="contain" />
      </a>
      <div class:list={['flex flex-1 flex-col', compact ? 'gap-1.5 pt-2.5' : 'gap-2 pt-3']}>
        <a href={`${booksHref}/${book.slug}/`} class="font-display text-lg font-semibold leading-snug text-teal-700 hover:text-coral-500">
          {book.title}
        </a>
        {hasAge && <p class="text-sm text-ink-light">{formatAgeRange(book, lang)}</p>}
        <div class="flex flex-wrap gap-1.5">
          {topBadges.map((topic) => <Badge label={translateLabel(topic, lang)} />)}
        </div>
        <a
          href={`${booksHref}/${book.slug}/`}
          class:list={[
            'mt-auto inline-flex items-center justify-center rounded-full bg-teal-700 px-4 text-sm font-bold text-cream-50 hover:bg-teal-600',
            compact ? 'py-1.5' : 'py-2',
          ]}
        >
          {ui.viewBook}
        </a>
      </div>
    </article>
  )
}
