---
import type { Book } from '../lib/books';
import { formatAgeRange } from '../lib/books';
import { translateLabel } from '../i18n/labels';
import { type Lang } from '../i18n/ui';
import BookCover from './BookCover.astro';
import Badge from './Badge.astro';

interface Props {
  book: Book;
  class?: string;
  lang?: Lang;
}
const { book, class: className = '', lang = 'en' } = Astro.props;
const booksHref = lang === 'es' ? '/es/books' : '/books';
const isComplete = Boolean(book.author && book.mlbSummary && book.audience && book.medicalTopics.length > 0);
const hasAge = book.ageMin != null || book.ageMax != null;
const topBadges = book.medicalTopics.slice(0, 2);
---

{
  isComplete && (
    <article
      class:list={[
        'card group relative flex h-full flex-col overflow-hidden p-3 transition hover:-translate-y-0.5 hover:shadow-lg',
        className,
      ]}
    >
      <BookCover book={book} lang={lang} fit="contain" ratio="square" />
      <div class="flex flex-1 flex-col gap-1.5 pt-3">
        {/* One link per card rather than three to the same page: the pseudo-element
            stretches it over the whole card, so the cover and the padding are
            clickable without repeating the destination for screen readers. */}
        <h3 class="font-display text-base font-semibold leading-snug text-teal-700 group-hover:text-coral-500">
          <a href={`${booksHref}/${book.slug}/`} class="line-clamp-2 after:absolute after:inset-0">
            {book.title}
          </a>
        </h3>
        {hasAge && <p class="text-sm text-ink-light">{formatAgeRange(book, lang)}</p>}
        {topBadges.length > 0 && (
          /* Above the stretched title link, which would otherwise swallow clicks
             meant for these topic links. */
          <div class="relative z-10 mt-auto flex flex-wrap gap-1.5 pt-1">
            {topBadges.map((topic) => <Badge label={translateLabel(topic, lang)} />)}
          </div>
        )}
      </div>
    </article>
  )
}
